DATABASE_URL=postgresql://jc@localhost/odin_file_uploader?host=/var/run/postgresql
# Optional direct hosted connection for Prisma migrations; runtime keeps DATABASE_URL.
DIRECT_DATABASE_URL=
TEST_DATABASE_URL=postgresql://jc@localhost/odin_file_uploader_test?host=/var/run/postgresql
SHADOW_DATABASE_URL=postgresql://jc@localhost/odin_file_uploader_shadow?host=/var/run/postgresql
SESSION_SECRET=replace-with-at-least-32-random-characters
PORT=3000
NODE_ENV=development
# Set to 1 only behind exactly one trusted reverse proxy (Render).
TRUST_PROXY_HOPS=0
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./var/files
TEMP_UPLOAD_DIR=./var/tmp
MAX_FILE_BYTES=5242880
MAX_USER_BYTES=52428800
MAX_USER_FILES=100
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=server-side-service-role-key
SUPABASE_BUCKET=private-files
