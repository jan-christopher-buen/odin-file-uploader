<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="A quiet place for your files. Private folders and simple, secure downloads."
    />
    <title><%= title %> · Folio</title>
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/assets/style.css" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="topbar">
      <a class="brand" href="/">
        <span class="brand-mark" aria-hidden="true">f</span> folio<span
          class="brand-dot"
          >.</span
        ></a
      >
      <span class="top-note">A little space. All yours.</span>
      <% if (user) { %>
      <div class="account">
        <span class="username"><%= user.username %></span>
        <form action="/logout" method="post">
          <input type="hidden" name="_csrf" value="<%= csrf %>" /><button
            class="text-button"
            type="submit"
          >
            Log out ↗
          </button>
        </form>
      </div>
      <% } else { %><span class="privacy-note">Private by design</span><% } %>
    </header>
    <main id="main"></main>
  </body>
</html>
